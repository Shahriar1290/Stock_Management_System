<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stock_management_system.CategoriesController">

    <HBox styleClass="page-header">
        <VBox>
            <Label styleClass="page-heading" text="Categories"/>
            <Label styleClass="page-subtitle" text="Group your products. Renaming a category updates all of its products."/>
        </VBox>
    </HBox>

    <VBox styleClass="card">
        <Label styleClass="card-title" text="Add a category"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtCategoryName" onAction="#addCategory" promptText="Category name" prefWidth="320"/>
            <Button onAction="#addCategory" styleClass="primary" text="Add category"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="renameButton" onAction="#renameCategory" text="Rename..."/>
            <Button fx:id="deleteButton" onAction="#deleteCategory" styleClass="danger" text="Delete"/>
        </HBox>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <StackPane styleClass="search-box" alignment="CENTER_LEFT" prefWidth="300">
            <TextField fx:id="searchField" styleClass="search-field" promptText="Search categories"/>
            <Region styleClass="icon,small,icon-search" mouseTransparent="true">
                <StackPane.margin><Insets left="11"/></StackPane.margin>
            </Region>
        </StackPane>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" styleClass="summary-label"/>
    </HBox>

    <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label styleClass="muted" text="No categories yet. Add one above."/></placeholder>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colName" text="Category" prefWidth="320"/>
            <TableColumn fx:id="colProducts" text="Products" prefWidth="140" styleClass="numeric"/>
        </columns>
    </TableView>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stock_management_system.ProductsController">

    <HBox styleClass="page-header">
        <VBox>
            <Label styleClass="page-heading" text="Products"/>
            <Label styleClass="page-subtitle" text="Add, edit and restock the items you sell. Select a row to edit it."/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exportCsv" text="Export CSV">
            <graphic><Region styleClass="icon,small,icon-download"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="card">
        <Label fx:id="formTitle" styleClass="card-title" text="New product"/>
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="NAME"/>
                <TextField fx:id="productNameField" promptText="e.g. Wireless mouse"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="CATEGORY"/>
                <ComboBox fx:id="categoryComboBox" maxWidth="Infinity" promptText="Select category"/>
            </VBox>
            <VBox spacing="6" prefWidth="130">
                <Label styleClass="field-label" text="PRICE"/>
                <TextField fx:id="priceField" promptText="0.00"/>
            </VBox>
            <VBox spacing="6" prefWidth="110">
                <Label styleClass="field-label" text="QUANTITY"/>
                <TextField fx:id="quantityField" promptText="0"/>
            </VBox>
            <VBox spacing="6" prefWidth="120">
                <Label styleClass="field-label" text="REORDER AT"/>
                <TextField fx:id="reorderField" promptText="5"/>
            </VBox>
        </HBox>
        <HBox spacing="10">
            <padding><Insets top="4"/></padding>
            <Button fx:id="addButton" onAction="#handleAddProduct" styleClass="primary" text="Add product"/>
            <Button fx:id="updateButton" onAction="#handleUpdateProduct" text="Save changes"/>
            <Button fx:id="restockButton" onAction="#handleRestock" text="Restock..."/>
            <Button onAction="#clearForm" styleClass="ghost" text="Clear"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="deleteButton" onAction="#handleDeleteProduct" styleClass="danger" text="Delete"/>
        </HBox>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <StackPane styleClass="search-box" alignment="CENTER_LEFT" prefWidth="300">
            <TextField fx:id="searchField" styleClass="search-field" promptText="Search products"/>
            <Region styleClass="icon,small,icon-search" mouseTransparent="true">
                <StackPane.margin><Insets left="11"/></StackPane.margin>
            </Region>
        </StackPane>
        <ComboBox fx:id="categoryFilter" prefWidth="190"/>
        <CheckBox fx:id="lowStockOnly" text="Low / out of stock only"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" styleClass="summary-label"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label styleClass="muted" text="No products match your filters."/></placeholder>
        <columns>
            <TableColumn fx:id="productNameColumn" text="Product" prefWidth="220"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="100" styleClass="numeric"/>
            <TableColumn fx:id="quantityColumn" text="Qty" prefWidth="80" styleClass="numeric"/>
            <TableColumn fx:id="reorderColumn" text="Reorder at" prefWidth="90" styleClass="numeric"/>
            <TableColumn fx:id="valueColumn" text="Stock value" prefWidth="120" styleClass="numeric"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>

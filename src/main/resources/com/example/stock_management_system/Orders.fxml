<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stock_management_system.OrderController">

    <HBox styleClass="page-header">
        <VBox>
            <Label styleClass="page-heading" text="Orders"/>
            <Label styleClass="page-subtitle" text="Record sales. Stock is deducted automatically and restored if an order is cancelled."/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exportCsv" text="Export CSV">
            <graphic><Region styleClass="icon,small,icon-download"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="card">
        <Label styleClass="card-title" text="New order"/>
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="PRODUCT"/>
                <ComboBox fx:id="productComboBox" maxWidth="Infinity" promptText="Select a product in stock"/>
            </VBox>
            <VBox spacing="6" prefWidth="140">
                <Label styleClass="field-label" text="QUANTITY"/>
                <TextField fx:id="quantityField" promptText="1"/>
            </VBox>
            <VBox spacing="2" prefWidth="200">
                <Label styleClass="field-label" text="ORDER TOTAL"/>
                <Label fx:id="totalPriceLabel" styleClass="total-value" text="0.00"/>
            </VBox>
            <Button fx:id="addOrderButton" defaultButton="true" onAction="#addOrder" styleClass="primary" text="Place order">
                <HBox.margin><Insets bottom="2"/></HBox.margin>
            </Button>
        </HBox>
        <Label fx:id="stockHintLabel" styleClass="muted"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <StackPane styleClass="search-box" alignment="CENTER_LEFT" prefWidth="260">
            <TextField fx:id="searchField" styleClass="search-field" promptText="Search by product"/>
            <Region styleClass="icon,small,icon-search" mouseTransparent="true">
                <StackPane.margin><Insets left="11"/></StackPane.margin>
            </Region>
        </StackPane>
        <Label styleClass="muted" text="From"/>
        <DatePicker fx:id="fromDate" prefWidth="140" promptText="Any"/>
        <Label styleClass="muted" text="To"/>
        <DatePicker fx:id="toDate" prefWidth="140" promptText="Any"/>
        <Button onAction="#clearFilters" styleClass="ghost" text="Reset"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" styleClass="summary-label"/>
        <Button fx:id="cancelOrderButton" onAction="#cancelOrder" styleClass="danger" text="Cancel order"/>
    </HBox>

    <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label styleClass="muted" text="No orders match your filters."/></placeholder>
        <columns>
            <TableColumn fx:id="idColumn" text="Order #" prefWidth="90"/>
            <TableColumn fx:id="productColumn" text="Product" prefWidth="260"/>
            <TableColumn fx:id="quantityColumn" text="Qty" prefWidth="90" styleClass="numeric"/>
            <TableColumn fx:id="totalPriceColumn" text="Total" prefWidth="140" styleClass="numeric"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>

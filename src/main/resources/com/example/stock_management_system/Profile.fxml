<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stock_management_system.ProfileController">

    <HBox styleClass="page-header">
        <VBox>
            <Label styleClass="page-heading" text="My Profile"/>
            <Label styleClass="page-subtitle" text="Update your details and password."/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="460">
            <Label styleClass="card-title" text="Account details"/>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="USERNAME"/>
                    <TextField fx:id="txtUsername" editable="false" disable="true"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="ROLE"/>
                    <TextField fx:id="txtRole" editable="false" disable="true"/>
                </VBox>
            </HBox>
            <Label styleClass="field-label" text="FULL NAME"/>
            <TextField fx:id="txtName"/>
            <Label styleClass="field-label" text="EMAIL"/>
            <TextField fx:id="txtEmail"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding><Insets top="6"/></padding>
                <Button onAction="#cancelUpdate" styleClass="ghost" text="Reset"/>
                <Button onAction="#updateProfile" styleClass="primary" text="Save details"/>
            </HBox>
        </VBox>

        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="460">
            <Label styleClass="card-title" text="Change password"/>
            <Label fx:id="passwordHint" styleClass="muted" wrapText="true"/>
            <Label styleClass="field-label" text="CURRENT PASSWORD"/>
            <PasswordField fx:id="txtCurrentPassword"/>
            <Label styleClass="field-label" text="NEW PASSWORD"/>
            <PasswordField fx:id="txtPassword"/>
            <Label styleClass="field-label" text="CONFIRM NEW PASSWORD"/>
            <PasswordField fx:id="txtConfirmPassword"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding><Insets top="6"/></padding>
                <Button onAction="#changePassword" styleClass="primary" text="Update password"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox fx:id="dataCard" styleClass="card">
        <Label styleClass="card-title" text="Backup and restore"/>
        <Label styleClass="muted" wrapText="true"
               text="Save a copy of all products, orders, suppliers, users and history, or replace the current data with a saved copy."/>
        <Label fx:id="databasePathLabel" styleClass="muted" wrapText="true"/>
        <HBox spacing="10">
            <padding><Insets top="4"/></padding>
            <Button onAction="#backupDatabase" styleClass="primary" text="Back up now...">
                <graphic><Region styleClass="icon,small,icon-download"/></graphic>
            </Button>
            <Button onAction="#restoreDatabase" styleClass="danger" text="Restore from backup..."/>
        </HBox>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stock_management_system.UsersController">

    <HBox styleClass="page-header">
        <VBox>
            <Label styleClass="page-heading" text="Users"/>
            <Label styleClass="page-subtitle" text="Manage who can sign in. Staff can work with stock and orders; only admins can delete records and manage users."/>
        </VBox>
    </HBox>

    <VBox styleClass="card">
        <Label styleClass="card-title" text="Add a user"/>
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="USERNAME"/>
                <TextField fx:id="usernameField" promptText="e.g. rahim"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="FULL NAME"/>
                <TextField fx:id="nameField" promptText="Full name"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="EMAIL"/>
                <TextField fx:id="emailField" promptText="name@example.com"/>
            </VBox>
            <VBox spacing="6" prefWidth="130">
                <Label styleClass="field-label" text="ROLE"/>
                <ComboBox fx:id="roleComboBox" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="PASSWORD"/>
                <PasswordField fx:id="passwordField"/>
            </VBox>
        </HBox>
        <HBox spacing="10">
            <padding><Insets top="4"/></padding>
            <Button onAction="#addUser" styleClass="primary" text="Add user"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="roleButton" onAction="#toggleRole" text="Change role"/>
            <Button fx:id="resetButton" onAction="#resetPassword" text="Reset password..."/>
            <Button fx:id="deleteButton" onAction="#deleteUser" styleClass="danger" text="Delete"/>
        </HBox>
    </VBox>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="160"/>
            <TableColumn fx:id="nameColumn" text="Full name" prefWidth="220"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="260"/>
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
